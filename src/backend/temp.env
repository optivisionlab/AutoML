### GENERAL SETTINGS ### 
# Minio
MINIO_ENDPOINT='localhost:9000' # Need when run worker, master
MINIO_ACCESS_KEY='' # Need when run worker, master
MINIO_SECRET_KEY='' # Need when run worker, master
PORT_BACK_END=8080
#==========================#
# Note: Use "::" for IPv6 to accept both IPv4 and IPv6 connections
HOST_BACK_END="::"
# If you build docker for worker server, IP must be able to ping the master server
# If you build docker for master server, IP should be 0.0.0.0
#==========================#

### WORKER SETTINGS ###
# Run worker server
WORKER_HOST="0.0.0.0"
WORKER_PORT=4000

### MASTER SETTINGS ###

# Configuration when running distributed in production
NUMBER_WORKERS=1

# Replace host and base port
WORKER_LIST='http://localhost:4000,http://localhost:4001,http://localhost:4002,http://localhost:4003' ...
# Because each worker will have a different IP

TASK_TIMEOUT_SECONDS=3600 # Time for master to check if worker is still active or not
MAX_TASK_SNOOZES=2 # Number of times a task can be snoozed before being considered failed

# Basic setup
SESSION_TIMEOUT=60
HOST_FRONT_END="0.0.0.0"
PORT_FRONT_END="3000"
KAFKA_SERVER="localhost:9092"
KAFKA_TOPIC=""
MONGODB_CONNECT= "localhost:27017"

# Config jwt
SECRET_KEY=""
ALGORITHM=""
ACCESS_EXPIRE=15
REFRESH_EXPIRE=7

# Config google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

REDIRECT_URI=""
FRONTEND_URL=""
SUPER_SECRET_KEY=""

# Email service
MAIL_USERNAME=""
MAIL_PASSWORD="" # app passwords
LOGO=""

### AGENT / LLM SETTINGS ###
# Nhà cung cấp LLM cho agent: openrouter (mặc định) | google | openai | azure
# PHẢI khớp với key bên dưới, nếu không agent sẽ báo thiếu key của provider khác.
LLM_PROVIDER=google

# OPENROUTER_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Azure OpenAI: ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<ten-resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=

# Slug model. ĐỂ TRỐNG thì tự dùng mặc định đúng theo provider - an toàn nhất.
# Chỉ bỏ comment khi muốn chỉ định cụ thể, và slug phải thuộc về provider ở trên
# (vd: google -> gemini-3.8-flash, openrouter -> anthropic/claude-sonnet-4.6).
# Tra tên tại openrouter.ai/models hoặc ai.google.dev/gemini-api/docs/models
# LLM_MODEL=

# URL backend mà agent gọi tới
HAUTOML_BASE_URL=http://localhost:9996

# Bật nhóm tool chỉ dùng khi phát triển (dev_verify_account: xác thực tài khoản
# mà không cần đọc email). Bỏ qua bước chứng minh quyền sở hữu email nên
# TUYỆT ĐỐI không bật ở môi trường thật.
# AGENT_DEV_TOOLS=1

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
