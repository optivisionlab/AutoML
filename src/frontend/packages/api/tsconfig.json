{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@automl/domain": ["../domain/src/index.ts"],
      "@automl/domain/*": ["../domain/src/*"]
    }
  },
  "include": ["src/**/*"]
}
